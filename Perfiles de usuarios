SELECTS PARA VERIFICAR ASIGNACIONES:

--Buscar roles creados
SELECT *
FROM DBA_ROLES
WHERE ROLE IN (
    'RL_ADM_AGENCIA',
    'RL_AGT_AGENCIA',
    'RL_SPV_AGENCIA'
);

--QUOTAS asignadas
SELECT username,
       tablespace_name,
       bytes,
       max_bytes
FROM dba_ts_quotas
WHERE username IN ('ADMINISTRADOR', 'AGENTE_VIAJES', 'SUPERVISOR');

--Buscar usuarios creados
SELECT username,
       default_tablespace,
       temporary_tablespace
FROM dba_users
WHERE username IN ('ADMINISTRADOR', 'AGENTE_VIAJES', 'SUPERVISOR');

--Si tienes un role asignado, entonces así es como se revisan los privilegios del role
SELECT *
FROM ROLE_SYS_PRIVS
WHERE ROLE IN (
    'RL_ADM_AGENCIA',
    'RL_AGT_AGENCIA',
    'RL_SPV_AGENCIA'
);
--Si tienes privilegios
SELECT *
FROM DBA_ROLE_PRIVS
WHERE GRANTEE IN ('ADMINISTRADOR', 'SUPERVISOR', 'AGENTE_VIAJES');

