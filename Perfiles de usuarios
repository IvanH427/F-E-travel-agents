Perfil asignado a Administrador:

CREATE PROFILE perfil_avanzado 
LIMIT
     -- Número máximo de intentos fallidos de inicio de sesión antes de bloquear la cuenta
     FAILED_LOGIN_ATTEMPTS 2
     -- Tiempo de vida de la contraseña: expira cada 30 días
     PASSWORD_LIFE_TIME 180
     -- Tiempo que permanece bloqueada la cuenta después de exceder los intentos fallidos (en días)
     PASSWORD_LOCK_TIME 1/8
     -- Tiempo mínimo (en días) que debe pasar para poder reutilizar una contraseña anterior
     PASSWORD_REUSE_TIME 180*3
     -- Número máximo de sesiones simultáneas permitidas por usuario
     SESSIONS_PER_USER 2 
     -- Tiempo de conexión
     CONNECT_TIME 720
     ;

-------------------------------------------------
Perfil asignado a Agente de viajes:

CREATE PROFILE perfil_basico 
LIMIT
     FAILED_LOGIN_ATTEMPTS 4
     PASSWORD_LIFE_TIME 120
     PASSWORD_LOCK_TIME 1/48 -- 30 minutos
     PASSWORD_REUSE_TIME 120*3 --3 contraseñas antes de repetir
     SESSIONS_PER_USER 3 
     CONNECT_TIME 480
     ;

-------------------------------------------------
Perfil asignado a Supervisor:

CREATE PROFILE perfil_medio 
LIMIT
     FAILED_LOGIN_ATTEMPTS 3
     PASSWORD_LIFE_TIME 90
     PASSWORD_LOCK_TIME 1/12 -- medio día
     PASSWORD_REUSE_TIME 90*3
     SESSIONS_PER_USER 2 
     CONNECT_TIME 600
     ;
     
