CREATE TABLE ROL (
    ID_ROL NUMBER GENERATED BY DEFAULT AS IDENTITY,
    NOMBRE_ROL VARCHAR2(100) NOT NULL,
    DESCRIPCION VARCHAR2(250),

    CONSTRAINT PK_ROL PRIMARY KEY (ID_ROL)
);

CREATE TABLE TELEFONO (
    ID_TELEFONO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    TELEFONO VARCHAR2(20) NOT NULL,
    TIPO_TELEFONO VARCHAR2(30),

    CONSTRAINT PK_TELEFONO
        PRIMARY KEY (ID_TELEFONO)
);

CREATE TABLE CLIENTE (
    ID_CLIENTE NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_TELEFONO NUMBER NOT NULL,

    NOMBRE VARCHAR2(100) NOT NULL,
    APELLIDO1 VARCHAR2(100) NOT NULL,
    APELLIDO2 VARCHAR2(100),
    CORREO VARCHAR2(150),

    FECHA_NACIMIENTO DATE,
    PASAPORTE VARCHAR2(50),
    NACIONALIDAD VARCHAR2(100),
    DIRECCION VARCHAR2(250),
    FECHA_REGISTRO DATE DEFAULT SYSDATE,

    CONSTRAINT PK_CLIENTE
        PRIMARY KEY (ID_CLIENTE),

    CONSTRAINT FK_CLIENTE_TELEFONO
        FOREIGN KEY (ID_TELEFONO)
        REFERENCES TELEFONO(ID_TELEFONO)
);

CREATE TABLE EMPLEADO (
    ID_EMPLEADO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_TELEFONO NUMBER NOT NULL,
    ID_ROL NUMBER NOT NULL,

    NOMBRE VARCHAR2(100) NOT NULL,
    APELLIDO1 VARCHAR2(100) NOT NULL,
    APELLIDO2 VARCHAR2(100),
    CORREO VARCHAR2(150),

    FECHA_CONTRATACION DATE,
    SALARIO NUMBER(12,2),

    CONSTRAINT PK_EMPLEADO
        PRIMARY KEY (ID_EMPLEADO),

    CONSTRAINT FK_EMPLEADO_ROL
        FOREIGN KEY (ID_ROL)
        REFERENCES ROL(ID_ROL),

    CONSTRAINT FK_EMPLEADO_TELEFONO
        FOREIGN KEY (ID_TELEFONO)
        REFERENCES TELEFONO(ID_TELEFONO)
);

CREATE TABLE DESTINO (
    ID_DESTINO NUMBER GENERATED BY DEFAULT AS IDENTITY,

    PAIS VARCHAR2(100) NOT NULL,
    CIUDAD VARCHAR2(100) NOT NULL,
    DESCRIPCION VARCHAR2(500),
    MONEDA VARCHAR2(50),
    IDIOMA VARCHAR2(50),

    CONSTRAINT PK_DESTINO
        PRIMARY KEY (ID_DESTINO)
);

CREATE TABLE SEGURO (
    ID_SEGURO NUMBER GENERATED BY DEFAULT AS IDENTITY,

    NOMBRE VARCHAR2(100) NOT NULL,
    COBERTURA VARCHAR2(300),
    MONTO_COBERTURA NUMBER(12,2),

    CONSTRAINT PK_SEGURO
        PRIMARY KEY (ID_SEGURO)
);

CREATE TABLE HOTEL (
    ID_HOTEL NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_DESTINO NUMBER NOT NULL,

    NOMBRE VARCHAR2(150) NOT NULL,
    CATEGORIA NUMBER(1),
    DIRECCION VARCHAR2(250),
    TELEFONO VARCHAR2(30),

    CANTIDAD_HABITACIONES NUMBER,
    CAPACIDAD NUMBER,
    PRECIO NUMBER(12,2),

    CONSTRAINT PK_HOTEL
        PRIMARY KEY (ID_HOTEL),

    CONSTRAINT FK_HOTEL_DESTINO
        FOREIGN KEY (ID_DESTINO)
        REFERENCES DESTINO(ID_DESTINO)
);

CREATE TABLE TRANSPORTE (
    ID_TRANSPORTE NUMBER GENERATED BY DEFAULT AS IDENTITY,

    NOMBRE VARCHAR2(150),
    TIPO_TRANSPORTE VARCHAR2(50),
    ORIGEN VARCHAR2(100),
    DESTINO VARCHAR2(100),

    FECHA_SALIDA DATE,
    FECHA_REGRESO DATE,

    CAPACIDAD_PERSONAS NUMBER,
    PRECIO NUMBER(12,2),

    CONSTRAINT PK_TRANSPORTE
        PRIMARY KEY (ID_TRANSPORTE)
);

CREATE TABLE PAQUETE (
    ID_PAQUETE NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_DESTINO NUMBER NOT NULL,

    NOMBRE_PAQUETE VARCHAR2(150) NOT NULL,
    DESCRIPCION VARCHAR2(500),

    PRECIO NUMBER(12,2),
    DURACION_DIAS NUMBER,

    CONSTRAINT PK_PAQUETE
        PRIMARY KEY (ID_PAQUETE),

    CONSTRAINT FK_PAQUETE_DESTINO
        FOREIGN KEY (ID_DESTINO)
        REFERENCES DESTINO(ID_DESTINO)
);

CREATE TABLE RESERVA (
    ID_RESERVA NUMBER GENERATED BY DEFAULT AS IDENTITY,

    ID_CLIENTE NUMBER NOT NULL,
    ID_EMPLEADO NUMBER NOT NULL,
    ID_PAQUETE NUMBER NOT NULL,
    ID_SEGURO NUMBER,

    FECHA_RESERVA DATE DEFAULT SYSDATE,
    FECHA_VIAJE DATE,

    CANTIDAD_PERSONAS NUMBER,
    TOTAL_PAGAR NUMBER(12,2),

    ESTADO VARCHAR2(50),

    CONSTRAINT PK_RESERVA
        PRIMARY KEY (ID_RESERVA),

    CONSTRAINT FK_RESERVA_CLIENTE
        FOREIGN KEY (ID_CLIENTE)
        REFERENCES CLIENTE(ID_CLIENTE),

    CONSTRAINT FK_RESERVA_EMPLEADO
        FOREIGN KEY (ID_EMPLEADO)
        REFERENCES EMPLEADO(ID_EMPLEADO),

    CONSTRAINT FK_RESERVA_PAQUETE
        FOREIGN KEY (ID_PAQUETE)
        REFERENCES PAQUETE(ID_PAQUETE),

    CONSTRAINT FK_RESERVA_SEGURO
        FOREIGN KEY (ID_SEGURO)
        REFERENCES SEGURO(ID_SEGURO)
);

CREATE TABLE PAGO (
    ID_PAGO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_RESERVA NUMBER NOT NULL,

    FECHA_PAGO DATE NOT NULL,
    MONTO NUMBER(12,2) NOT NULL,

    METODO_PAGO VARCHAR2(50),
    ESTADO_PAGO VARCHAR2(50),

    CONSTRAINT PK_PAGO
        PRIMARY KEY (ID_PAGO),

    CONSTRAINT FK_PAGO_RESERVA
        FOREIGN KEY (ID_RESERVA)
        REFERENCES RESERVA(ID_RESERVA)
);
