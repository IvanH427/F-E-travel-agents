CREATE TABLE TRANSPORTE (
    ID_TRANSPORTE NUMBER,

    NOMBRE VARCHAR2(150) NOT NULL,
    TIPO_TRANSPORTE VARCHAR2(50),
    ORIGEN VARCHAR2(100) NOT NULL,
    DESTINO VARCHAR2(100) NOT NULL,

    FECHA_SALIDA DATE NOT NULL,
    FECHA_REGRESO DATE NOT NULL,
    
    CAPACIDAD_PERSONAS NUMBER NOT NULL 
        CONSTRAINT CHK_PERSONAS_TRANSP 
            CHECK (CAPACIDAD_PERSONAS > 0),
        
    PRECIO NUMBER(12,2) NOT NULL 
        CONSTRAINT CHK_PRECIO_TRANSP 
            CHECK (PRECIO > 0),

    CONSTRAINT PK_TRANSPORTE
        PRIMARY KEY (ID_TRANSPORTE),
     
    CONSTRAINT CHK_FECHA_REGRESO_TRANSP 
        CHECK (FECHA_REGRESO > FECHA_SALIDA)
    );

CREATE TABLE PAQUETE (
    ID_PAQUETE NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_DESTINO NUMBER NOT NULL,
    ID_TRANSPORTE NUMBER, 
    
    NOMBRE_PAQUETE VARCHAR2(150) NOT NULL,
    DESCRIPCION VARCHAR2(500),

    PRECIO NUMBER(12,2) CONSTRAINT CHK_PRECIO CHECK (PRECIO > 0),
    DURACION_DIAS NUMBER CONSTRAINT CHK_DURACION_DIAS CHECK (DURACION_DIAS >= 0),

    CONSTRAINT PK_PAQUETE
        PRIMARY KEY (ID_PAQUETE),

    CONSTRAINT FK_PAQUETE_DESTINO
        FOREIGN KEY (ID_DESTINO)
        REFERENCES DESTINO(ID_DESTINO),
        
    CONSTRAINT FK_PAQUETE_TRANSPORTE
        FOREIGN KEY (ID_TRANSPORTE)
        REFERENCES TRANSPORTE(ID_TRANSPORTE)
);

CREATE TABLE RESERVA (
    ID_RESERVA NUMBER GENERATED BY DEFAULT AS IDENTITY,

    ID_CLIENTE NUMBER NOT NULL,
    ID_EMPLEADO NUMBER NOT NULL,
    ID_PAQUETE NUMBER NOT NULL,
    ID_SEGURO NUMBER,

    FECHA_RESERVA DATE DEFAULT SYSDATE,
    FECHA_VIAJE DATE,

    CANTIDAD_PERSONAS NUMBER NOT NULL CONSTRAINT CHK_CAN_PERSONAS CHECK(CANTIDAD_PERSONAS > 0),
    TOTAL_PAGAR NUMBER(12,2) NOT NULL CONSTRAINT CHK_TOTAL_PAGAR_RESERVA CHECK(TOTAL_PAGAR > 0),

    ESTADO VARCHAR2(50),

    CONSTRAINT PK_RESERVA
        PRIMARY KEY (ID_RESERVA),

    CONSTRAINT FK_RESERVA_CLIENTE
        FOREIGN KEY (ID_CLIENTE)
        REFERENCES CLIENTE(ID_CLIENTE),

    CONSTRAINT FK_RESERVA_EMPLEADO
        FOREIGN KEY (ID_EMPLEADO)
        REFERENCES EMPLEADO(ID_EMPLEADO),

    CONSTRAINT FK_RESERVA_PAQUETE
        FOREIGN KEY (ID_PAQUETE)
        REFERENCES PAQUETE(ID_PAQUETE),

    CONSTRAINT FK_RESERVA_SEGURO
        FOREIGN KEY (ID_SEGURO)
        REFERENCES SEGURO(ID_SEGURO),
        
    CONSTRAINT CHK_FECHA_VIAJE 
        CHECK (FECHA_VIAJE > FECHA_RESERVA)
);

CREATE TABLE PAGO (
    ID_PAGO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_RESERVA NUMBER NOT NULL,

    FECHA_PAGO DATE NOT NULL,
    MONTO NUMBER(12,2) NOT NULL CONSTRAINT CHK_MONTO_PAGO CHECK(MONTO > 0) ,

    METODO_PAGO VARCHAR2(50),
    ESTADO_PAGO VARCHAR2(50) CONSTRAINT CHK_ESTADO_P_PAGO CHECK(ESTADO_PAGO IN ('PENDIENTE','CANCELADO', 'COMPLETADO')) ,

    CONSTRAINT PK_PAGO
        PRIMARY KEY (ID_PAGO),

    CONSTRAINT FK_PAGO_RESERVA
        FOREIGN KEY (ID_RESERVA)
        REFERENCES RESERVA(ID_RESERVA)
);
COMMIT;

-- =====================================================================
CAMBIOS REALIZADOS PARA SEGUNDO AVANCE:
-- =====================================================================

-- =====================================================================
-- 1. DESNORMALIZACION DE PAGO
-- IDEA:  guardar en PAGO la MONEDA en que esta expresado el monto.
-- LOGICA: un monto sin moneda es ambiguo (150000 puede ser colones o
--         dolares). Hoy la moneda solo se sabe recorriendo
--         PAGO -> RESERVA -> PAQUETE -> DESTINO (3 JOINs). La moneda de
--         un destino casi nunca cambia, es un dato estable y de lectura
--         frecuente, por lo que es un buen candidato a desnormalizar.
--         Ademas permite agrupar pagos por moneda sin ningun JOIN.
-- =====================================================================

-- 1.1 Agregar la columna
ALTER TABLE PAGO ADD (MONEDA VARCHAR2(10));

-- 3.2 Carga inicial: copiar la moneda del destino de cada pago
UPDATE PAGO p
   SET MONEDA = (SELECT d.MONEDA
                   FROM RESERVA r
                   JOIN PAQUETE pq ON pq.ID_PAQUETE = r.ID_PAQUETE
                   JOIN DESTINO d  ON d.ID_DESTINO  = pq.ID_DESTINO
                  WHERE r.ID_RESERVA = p.ID_RESERVA);
COMMIT;

-- 1.3 Mantenimiento automatico (trigger sobre PAGO).
--     IDEA:  al insertar un pago, la MONEDA se llena sola.
--     LOGICA: asi la aplicacion o el usuario no tienen que indicarla (ni
--            pueden equivocarse al escribirla). Es un trigger BEFORE
--            INSERT porque modifica el valor ANTES de guardar la fila.
--            Lee RESERVA, PAQUETE y DESTINO (otras tablas), por lo que
--            no hay problema de tabla mutante.
--     LIMITACION CONOCIDA: si despues se cambia el paquete de una
--            reserva a un destino con otra moneda, los pagos ya
--            registrados conservan la moneda original. Esto es lo
--            correcto contablemente: el pago se hizo en esa moneda.
CREATE OR REPLACE TRIGGER TRG_PAGO_DESNORMALIZA
BEFORE INSERT ON PAGO
FOR EACH ROW
BEGIN
    SELECT d.MONEDA
      INTO :NEW.MONEDA
      FROM RESERVA r
      JOIN PAQUETE pq ON pq.ID_PAQUETE = r.ID_PAQUETE
      JOIN DESTINO d  ON d.ID_DESTINO  = pq.ID_DESTINO
     WHERE r.ID_RESERVA = :NEW.ID_RESERVA;
EXCEPTION
    WHEN NO_DATA_FOUND THEN NULL;   -- si la reserva no existe, la FK de PAGO ya rechaza el insert
END TRG_PAGO_DESNORMALIZA;
/

-- 1.4 Verificacion: no deben quedar pagos sin moneda (debe dar 0)
SELECT COUNT(*) AS PAGOS_SIN_MONEDA FROM PAGO WHERE MONEDA IS NULL;

COMMIT;

