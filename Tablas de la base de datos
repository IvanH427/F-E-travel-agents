CREATE TABLE CLIENTE (
    ID_CLIENTE NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_TELEFONO NUMBER NOT NULL,

    NOMBRE VARCHAR2(100) NOT NULL,
    APELLIDO1 VARCHAR2(100) NOT NULL,
    APELLIDO2 VARCHAR2(100),
    CORREO VARCHAR2(150),

    FECHA_NACIMIENTO DATE,
    PASAPORTE VARCHAR2(50),
    NACIONALIDAD VARCHAR2(100),
    DIRECCION VARCHAR2(250),
    FECHA_REGISTRO DATE DEFAULT SYSDATE,

    CONSTRAINT PK_CLIENTE
        PRIMARY KEY (ID_CLIENTE),

    CONSTRAINT FK_CLIENTE_TELEFONO
        FOREIGN KEY (ID_TELEFONO)
        REFERENCES TELEFONO(ID_TELEFONO)
);
CREATE TABLE EMPLEADO (
    ID_EMPLEADO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_ROL NUMBER NOT NULL,
    NOMBRE VARCHAR2(100) NOT NULL,
    APELLIDO1 VARCHAR2(100) NOT NULL,
    APELLIDO2 VARCHAR2(100),
    CORREO VARCHAR2(150),
    FECHA_CONTRATACION DATE,
    SALARIO NUMBER(12,2),

    CONSTRAINT PK_EMPLEADO PRIMARY KEY (ID_EMPLEADO),

    CONSTRAINT FK_EMPLEADO_ROL
        FOREIGN KEY (ID_ROL)
        REFERENCES ROL(ID_ROL)
);

CREATE TABLE DESTINO (
    ID_DESTINO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    PAIS VARCHAR2(100) NOT NULL,
    CIUDAD VARCHAR2(100) NOT NULL,
    DESCRIPCION VARCHAR2(500),
    MONEDA VARCHAR2(50),
    IDIOMA VARCHAR2(50),

    CONSTRAINT PK_DESTINO PRIMARY KEY (ID_DESTINO)
);

CREATE TABLE AEROLINEA (
    ID_AEROLINEA NUMBER GENERATED BY DEFAULT AS IDENTITY,
    NOMBRE VARCHAR2(150) NOT NULL,
    PAIS_ORIGEN VARCHAR2(100),
    SITIO_WEB VARCHAR2(200),

    CONSTRAINT PK_AEROLINEA PRIMARY KEY (ID_AEROLINEA)
);

CREATE TABLE SEGURO (
    ID_SEGURO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    NOMBRE VARCHAR2(100) NOT NULL,
    COBERTURA VARCHAR2(300),
    MONTO_COBERTURA NUMBER(12,2),

    CONSTRAINT PK_SEGURO PRIMARY KEY (ID_SEGURO)
);

CREATE TABLE HOTEL (
    ID_HOTEL NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_DESTINO NUMBER NOT NULL,
    NOMBRE VARCHAR2(150) NOT NULL,
    CATEGORIA NUMBER(1),
    DIRECCION VARCHAR2(250),
    TELEFONO VARCHAR2(30),
    CANTIDAD_HABITACIONES NUMBER,
    CAPACIDAD NUMBER,
    PRECIO NUMBER(12,2),

    CONSTRAINT PK_HOTEL PRIMARY KEY (ID_HOTEL),

    CONSTRAINT FK_HOTEL_DESTINO
        FOREIGN KEY (ID_DESTINO)
        REFERENCES DESTINO(ID_DESTINO)
);

CREATE TABLE GUIA (
    ID_GUIA NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_DESTINO NUMBER NOT NULL,
    NOMBRE VARCHAR2(100) NOT NULL,
    IDIOMA VARCHAR2(50),
    EXPERIENCIA_ANIOS NUMBER(3),
    TARIFA NUMBER(12,2),

    CONSTRAINT PK_GUIA PRIMARY KEY (ID_GUIA),

    CONSTRAINT FK_GUIA_DESTINO
        FOREIGN KEY (ID_DESTINO)
        REFERENCES DESTINO(ID_DESTINO)
);

CREATE TABLE TRANSPORTE (
    ID_TRANSPORTE NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_AEROLINEA NUMBER NOT NULL,
    NOMBRE VARCHAR2(150),
    TIPO_TRANSPORTE VARCHAR2(50),
    ORIGEN VARCHAR2(100),
    DESTINO VARCHAR2(100),
    FECHA_SALIDA DATE,
    FECHA_REGRESO DATE,
    CAPACIDAD_PERSONAS NUMBER,
    PRECIO NUMBER(12,2),

    CONSTRAINT PK_TRANSPORTE PRIMARY KEY (ID_TRANSPORTE),

    CONSTRAINT FK_TRANSPORTE_AEROLINEA
        FOREIGN KEY (ID_AEROLINEA)
        REFERENCES AEROLINEA(ID_AEROLINEA)
);

CREATE TABLE CRUCERO (
    ID_CRUCERO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    NOMBRE VARCHAR2(150) NOT NULL,
    COMPANIA VARCHAR2(150),
    PUERTO_SALIDA VARCHAR2(100),
    PUERTO_LLEGADA VARCHAR2(100),
    FECHA_SALIDA DATE,
    FECHA_LLEGADA DATE,
    CAPACIDAD NUMBER,
    PRECIO NUMBER(12,2),

    CONSTRAINT PK_CRUCERO PRIMARY KEY (ID_CRUCERO)
);

CREATE TABLE PAQUETE (
    ID_PAQUETE NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_DESTINO NUMBER NOT NULL,
    NOMBRE_PAQUETE VARCHAR2(150) NOT NULL,
    DESCRIPCION VARCHAR2(500),
    PRECIO NUMBER(12,2),
    DURACION_DIAS NUMBER,

    CONSTRAINT PK_PAQUETE PRIMARY KEY (ID_PLAN),

    CONSTRAINT FK_PAQUETE_DESTINO
        FOREIGN KEY (ID_DESTINO)
        REFERENCES DESTINO(ID_DESTINO)
);

CREATE TABLE RESERVA (
    ID_RESERVA NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_CLIENTE NUMBER NOT NULL,
    ID_EMPLEADO NUMBER NOT NULL,
    ID_PLAN NUMBER NOT NULL,
    ID_SEGURO NUMBER,
    FECHA_RESERVA DATE DEFAULT SYSDATE,
    FECHA_VIAJE DATE,
    CANTIDAD_PERSONAS NUMBER,
    TOTAL_PAGAR NUMBER(12,2),
    ESTADO VARCHAR2(50),

    CONSTRAINT PK_RESERVA PRIMARY KEY (ID_RESERVA),

    CONSTRAINT FK_RESERVA_CLIENTE
        FOREIGN KEY(ID_CLIENTE)
        REFERENCES CLIENTE(ID_CLIENTE),

    CONSTRAINT FK_RESERVA_EMPLEADO
        FOREIGN KEY(ID_EMPLEADO)
        REFERENCES EMPLEADO(ID_EMPLEADO),

    CONSTRAINT FK_RESERVA_PLAN
        FOREIGN KEY(ID_PLAN)
        REFERENCES PLAN(ID_PLAN),

    CONSTRAINT FK_RESERVA_SEGURO
        FOREIGN KEY(ID_SEGURO)
        REFERENCES SEGURO(ID_SEGURO)
);

CREATE TABLE PAGO (
    ID_PAGO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_RESERVA NUMBER NOT NULL,
    FECHA_PAGO DATE NOT NULL,
    MONTO NUMBER(12,2) NOT NULL,
    METODO_PAGO VARCHAR2(50),
    ESTADO_PAGO VARCHAR2(50),

    CONSTRAINT PK_PAGO PRIMARY KEY (ID_PAGO),

    CONSTRAINT FK_PAGO_RESERVA
        FOREIGN KEY (ID_RESERVA)
        REFERENCES RESERVA(ID_RESERVA)
);

CREATE TABLE DETALLE_RESERVA (
    ID_DETALLE NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_RESERVA NUMBER NOT NULL,
    CONCEPTO VARCHAR2(100),
    DESCRIPCION VARCHAR2(500),
    CANTIDAD NUMBER,
    PRECIO_UNITARIO NUMBER(12,2),

    CONSTRAINT PK_DETALLE_RESERVA PRIMARY KEY (ID_DETALLE),

    CONSTRAINT FK_DETALLE_RESERVA
        FOREIGN KEY (ID_RESERVA)
        REFERENCES RESERVA(ID_RESERVA)
);

CREATE TABLE PLAN_HOTEL (
    ID_PLAN NUMBER NOT NULL,
    ID_HOTEL NUMBER NOT NULL,

    CONSTRAINT PK_PLAN_HOTEL
        PRIMARY KEY (ID_PLAN, ID_HOTEL),

    CONSTRAINT FK_PH_PLAN
        FOREIGN KEY (ID_PLAN)
        REFERENCES PLAN(ID_PLAN),

    CONSTRAINT FK_PH_HOTEL
        FOREIGN KEY (ID_HOTEL)
        REFERENCES HOTEL(ID_HOTEL)
);

CREATE TABLE PLAN_TRANSPORTE (
    ID_PLAN NUMBER NOT NULL,
    ID_TRANSPORTE NUMBER NOT NULL,

    CONSTRAINT PK_PLAN_TRANSPORTE
        PRIMARY KEY (ID_PLAN, ID_TRANSPORTE),

    CONSTRAINT FK_PT_PLAN
        FOREIGN KEY (ID_PLAN)
        REFERENCES PLAN(ID_PLAN),

    CONSTRAINT FK_PT_TRANSPORTE
        FOREIGN KEY (ID_TRANSPORTE)
        REFERENCES TRANSPORTE(ID_TRANSPORTE)
);

CREATE TABLE PLAN_CRUCERO (
    ID_PLAN NUMBER NOT NULL,
    ID_CRUCERO NUMBER NOT NULL,

    CONSTRAINT PK_PLAN_CRUCERO
        PRIMARY KEY (ID_PLAN, ID_CRUCERO),

    CONSTRAINT FK_PC_PLAN
        FOREIGN KEY (ID_PLAN)
        REFERENCES PLAN(ID_PLAN),

    CONSTRAINT FK_PC_CRUCERO
        FOREIGN KEY (ID_CRUCERO)
        REFERENCES CRUCERO(ID_CRUCERO)
);

CREATE TABLE PLAN_GUIA (
    ID_PLAN NUMBER NOT NULL,
    ID_GUIA NUMBER NOT NULL,

    CONSTRAINT PK_PLAN_GUIA
        PRIMARY KEY (ID_PLAN, ID_GUIA),

    CONSTRAINT FK_PG_PLAN
        FOREIGN KEY (ID_PLAN)
        REFERENCES PLAN(ID_PLAN),

    CONSTRAINT FK_PG_GUIA
        FOREIGN KEY (ID_GUIA)
        REFERENCES GUIA(ID_GUIA)
);
