-- 2.2 Pagos por mes, estado y moneda
--     PARA QUE SIRVE: control de ingresos, pagos pendientes y cancelados.
--     LOGICA: usa la columna PAGO.MONEDA desnormalizada, por eso lee
--             SOLO la tabla PAGO, sin ningun JOIN. Aqui se ve el
--             beneficio directo de la desnormalizacion de la seccion 3.
CREATE MATERIALIZED VIEW MV_PAGOS_MES
BUILD IMMEDIATE
REFRESH COMPLETE  ON DEMAND
AS
SELECT TRUNC(FECHA_PAGO, 'MM') AS MES,
       ESTADO_PAGO,
       MONEDA,
       COUNT(*)                AS CANT_PAGOS,
       SUM(MONTO)              AS TOTAL_MONTO
  FROM PAGO
 GROUP BY TRUNC(FECHA_PAGO, 'MM'), ESTADO_PAGO, MONEDA;


-- =====================================================================
-- 3. REFRESCO DE LAS VISTAS MATERIALIZADAS
-- IDEA:  como son ON DEMAND, hay que indicar cuando se actualizan.
-- LOGICA: se ofrecen dos formas.
-- =====================================================================

-- 3.1 Manual: util despues de cargar datos o antes de una presentacion.
--     'C' = COMPLETE (recalcula todo).
BEGIN
    DBMS_MVIEW.REFRESH('MV_VENTAS_DESTINO_MES', 'C');
    DBMS_MVIEW.REFRESH('MV_PAGOS_MES', 'C');
END;
/

-- 3.2 Automatico: un job de DBMS_SCHEDULER las refresca todos los dias
--     a las 2:00 a.m., hora de baja actividad, para no competir con las
--     operaciones del dia. Los reportes quedan como maximo un dia
--     desactualizados, lo cual es aceptable para reportes gerenciales.
BEGIN
    DBMS_SCHEDULER.CREATE_JOB(
        job_name        => 'JOB_REFRESH_MVS_AGENCIA',
        job_type        => 'PLSQL_BLOCK',
        job_action      => 'BEGIN DBMS_MVIEW.REFRESH(''MV_VENTAS_DESTINO_MES'',''C''); DBMS_MVIEW.REFRESH(''MV_PAGOS_MES'',''C''); END;',
        start_date      => SYSTIMESTAMP,
        repeat_interval => 'FREQ=DAILY;BYHOUR=2;BYMINUTE=0;BYSECOND=0',
        enabled         => TRUE,
        comments        => 'Refresco diario de vistas materializadas');
END;
/

-- Verificar que el job quedo creado
SELECT job_name, enabled, repeat_interval FROM user_scheduler_jobs
 WHERE job_name = 'JOB_REFRESH_MVS_AGENCIA';


SELECT *
FROM MV_PAGOS_MES;
