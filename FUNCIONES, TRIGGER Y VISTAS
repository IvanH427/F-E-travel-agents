--TRIGGER PARA APOYAR DESNORMALIZACIÓN
CREATE OR REPLACE TRIGGER trg_calcular_total
BEFORE INSERT OR UPDATE
ON reserva
FOR EACH ROW
DECLARE
    v_precio_paquete paquete.precio%TYPE;
BEGIN

    SELECT precio
    INTO v_precio_paquete
    FROM paquete
    WHERE id_paquete = :NEW.id_paquete;

    :NEW.total_pagar :=
        (v_precio_paquete * :NEW.cantidad_personas)
        * 1.05;

END;
/

-- =====================================================================
-- 2. VISTAS MATERIALIZADAS
-- IDEA GENERAL: una vista normal vuelve a ejecutar su consulta cada vez
--   que se usa. Una vista materializada guarda el resultado fisicamente
--   y se consulta como una tabla, por lo que es ideal para reportes con
--   JOINs y agrupaciones sobre muchos datos.
--
-- PARAMETROS USADOS:
--   BUILD IMMEDIATE       -> se llena en el momento de crearla.
--   REFRESH COMPLETE      -> al refrescar, se recalcula todo desde cero.
--   ON DEMAND             -> el refresco ocurre cuando se pide (manual o
--                            por un job), no en cada COMMIT.
--   LOGICA de COMPLETE + ON DEMAND (y no FAST / ON COMMIT): el refresco
--   rapido exige crear "materialized view logs" sobre las tablas base y
--   ralentiza cada INSERT/UPDATE de la operacion diaria. Para los
--   volumenes de esta agencia y reportes que no necesitan estar al
--   segundo, un refresco completo programado es mas simple y no
--   penaliza las transacciones.
--
-- Todas agrupan por MONEDA para no sumar colones con dolares.
-- =====================================================================

-- 2.1 Ventas por mes y destino
--     PARA QUE SIRVE: gerencia ve que destinos se venden mas y cuanto.
--     LOGICA: excluye reservas CANCELADAS (no fueron transacciones finalizadas) y
--             agrupa por mes con TRUNC(fecha, 'MM').

SELECT * FROM USER_MVIEWS;

CREATE MATERIALIZED VIEW MV_VENTAS_DESTINO_MES
BUILD IMMEDIATE
REFRESH COMPLETE ON DEMAND
AS
SELECT TRUNC(r.FECHA_RESERVA, 'MM') AS MES,
       d.ID_DESTINO,
       d.PAIS,
       d.CIUDAD,
       d.MONEDA,
       COUNT(*)                     AS CANT_RESERVAS,
       SUM(r.CANTIDAD_PERSONAS)     AS TOTAL_PERSONAS,
       SUM(r.TOTAL_PAGAR)           AS TOTAL_VENDIDO
  FROM RESERVA r
  JOIN PAQUETE p ON p.ID_PAQUETE = r.ID_PAQUETE
  JOIN DESTINO d ON d.ID_DESTINO = p.ID_DESTINO
 WHERE r.ESTADO <> 'CANCELADA'
 GROUP BY TRUNC(r.FECHA_RESERVA, 'MM'), d.ID_DESTINO, d.PAIS, d.CIUDAD, d.MONEDA;
