CREATE MATERIALIZED VIEW TOTAL_VENTAS
BUILD IMMEDIATE
REFRESH COMPLETE
START WITH SYSDATE
NEXT SYSDATE + 7
AS
SELECT
    P.ID_PAGO,
    R.ID_RESERVA,
    P.FECHA_PAGO,
    P.METODO_PAGO,
    P.MONTO,
    R.TOTAL_PAGAR,
    D.MONEDA
FROM PAGO P
INNER JOIN RESERVA R  ON R.ID_RESERVA  = P.ID_RESERVA
INNER JOIN PAQUETE PQ ON PQ.ID_PAQUETE = R.ID_PAQUETE
INNER JOIN DESTINO D  ON D.ID_DESTINO  = PQ.ID_DESTINO
WHERE P.ESTADO_PAGO = 'COMPLETADO';

