CREATE AUDIT POLICY POL_AT_SESIONES 

    ACTIONS LOGON, LOGOFF; 

 

AUDIT POLICY POL_AT_SESIONES BY ADMINISTRADOR, SUPERVISOR, AGENTE_VIAJES; 

CREATE AUDIT POLICY POL_AT_LOGON_FALLIDO 

    ACTIONS LOGON; 

AUDIT POLICY POL_AT_LOGON_FALLIDO WHENEVER NOT SUCCESSFUL; 

 

CREATE AUDIT POLICY POL_AT_DML_SENSIBLE 

    ACTIONS INSERT ON ADMINISTRADOR.PAGO, 

            UPDATE ON ADMINISTRADOR.PAGO, 

            DELETE ON ADMINISTRADOR.PAGO, 

            INSERT ON ADMINISTRADOR.RESERVA, 

            UPDATE ON ADMINISTRADOR.RESERVA, 

            DELETE ON ADMINISTRADOR.RESERVA, 

            INSERT ON ADMINISTRADOR.CLIENTE, 

            UPDATE ON ADMINISTRADOR.CLIENTE, 

            DELETE ON ADMINISTRADOR.CLIENTE, 

            INSERT ON ADMINISTRADOR.EMPLEADO, 

            UPDATE ON ADMINISTRADOR.EMPLEADO, 

            DELETE ON ADMINISTRADOR.EMPLEADO; 

AUDIT POLICY POL_AT_DML_SENSIBLE; 

 

CREATE AUDIT POLICY POL_AT_LECTURA_EMPLEADO 

    ACTIONS SELECT ON ADMINISTRADOR.EMPLEADO; 

AUDIT POLICY POL_AT_LECTURA_EMPLEADO; 

 

CREATE AUDIT POLICY POL_AT_DDL_ESQUEMA 

    ACTIONS CREATE TABLE, ALTER TABLE, DROP TABLE, 

            CREATE VIEW,  ALTER VIEW,  DROP VIEW, 

            CREATE INDEX, ALTER INDEX, DROP INDEX, 

            GRANT, REVOKE; 

AUDIT POLICY POL_AT_DDL_ESQUEMA BY ADMINISTRADOR, SUPERVISOR, AGENTE_VIAJES; 

 

CREATE AUDIT POLICY POL_AT_GESTION_CUENTAS 

    ACTIONS CREATE USER,    ALTER USER,    DROP USER, 

            CREATE ROLE,    ALTER ROLE,    DROP ROLE, 

            CREATE PROFILE, ALTER PROFILE, DROP PROFILE; 

AUDIT POLICY POL_AT_GESTION_CUENTAS; 

 

CREATE AUDIT POLICY POL_AT_PRIV_ANY 

    PRIVILEGES SELECT ANY TABLE, INSERT ANY TABLE, UPDATE ANY TABLE, 

               DELETE ANY TABLE, ALTER ANY TABLE,  DROP ANY TABLE; 

AUDIT POLICY POL_AT_PRIV_ANY BY SUPERVISOR, AGENTE_VIAJES; 
